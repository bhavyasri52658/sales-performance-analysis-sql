-- 3. VIEW ALL SALES

SELECT *
FROM sales_data;


-- 4. TOTAL REVENUE FROM COMPLETED SALES

SELECT
    SUM(quantity * unit_price) AS total_revenue
FROM sales_data
WHERE sale_status = 'Completed';


-- 5. TOTAL NUMBER OF SALES

SELECT
    COUNT(*) AS total_sales
FROM sales_data;


-- 6. REVENUE BY PRODUCT

SELECT
    product_name,
    SUM(quantity * unit_price) AS total_revenue
FROM sales_data
WHERE sale_status = 'Completed'
GROUP BY product_name
ORDER BY total_revenue DESC;


-- 7. REVENUE BY CATEGORY

SELECT
    category,
    SUM(quantity * unit_price) AS category_revenue
FROM sales_data
WHERE sale_status = 'Completed'
GROUP BY category
ORDER BY category_revenue DESC;


-- 8. REVENUE BY REGION

SELECT
    region,
    SUM(quantity * unit_price) AS regional_revenue
FROM sales_data
WHERE sale_status = 'Completed'
GROUP BY region
ORDER BY regional_revenue DESC;


-- 9. SALESPERSON PERFORMANCE

SELECT
    salesperson,
    COUNT(*) AS completed_sales,
    SUM(quantity * unit_price) AS total_revenue
FROM sales_data
WHERE sale_status = 'Completed'
GROUP BY salesperson
ORDER BY total_revenue DESC;


-- 10. MONTHLY REVENUE

SELECT
    DATE_TRUNC('month', sale_date)::DATE AS sales_month,
    SUM(quantity * unit_price) AS monthly_revenue
FROM sales_data
WHERE sale_status = 'Completed'
GROUP BY DATE_TRUNC('month', sale_date)
ORDER BY sales_month;


-- 11. MONTH-OVER-MONTH REVENUE GROWTH

WITH monthly_sales AS (
    SELECT
        DATE_TRUNC('month', sale_date)::DATE AS sales_month,
        SUM(quantity * unit_price) AS revenue
    FROM sales_data
    WHERE sale_status = 'Completed'
    GROUP BY DATE_TRUNC('month', sale_date)
),
sales_with_previous AS (
    SELECT
        sales_month,
        revenue,
        LAG(revenue) OVER (
            ORDER BY sales_month
        ) AS previous_month_revenue
    FROM monthly_sales
)
SELECT
    sales_month,
    revenue,
    previous_month_revenue,
    ROUND(
        100.0 * (revenue - previous_month_revenue)
        / NULLIF(previous_month_revenue, 0),
        2
    ) AS growth_percentage
FROM sales_with_previous
ORDER BY sales_month;


-- 12. TOP 3 PRODUCTS BY REVENUE

SELECT
    product_name,
    SUM(quantity * unit_price) AS total_revenue
FROM sales_data
WHERE sale_status = 'Completed'
GROUP BY product_name
ORDER BY total_revenue DESC
LIMIT 3;


-- 13. QUANTITY SOLD BY PRODUCT

SELECT
    product_name,
    SUM(quantity) AS total_units_sold
FROM sales_data
WHERE sale_status = 'Completed'
GROUP BY product_name
ORDER BY total_units_sold DESC;


-- 14. SALES STATUS SUMMARY

SELECT
    sale_status,
    COUNT(*) AS number_of_sales
FROM sales_data
GROUP BY sale_status;


-- 15. CANCELLATION RATE

SELECT
    COUNT(*) AS total_sales,
    COUNT(*) FILTER (
        WHERE sale_status = 'Cancelled'
    ) AS cancelled_sales,
    ROUND(
        100.0 * COUNT(*) FILTER (
            WHERE sale_status = 'Cancelled'
        ) / COUNT(*),
        2
    ) AS cancellation_rate
FROM sales_data;


-- 16. AVERAGE COMPLETED SALE VALUE

SELECT
    ROUND(
        AVG(quantity * unit_price),
        2
    ) AS average_sale_value
FROM sales_data
WHERE sale_status = 'Completed';


-- 17. REGION-WISE CATEGORY PERFORMANCE

SELECT
    region,
    category,
    SUM(quantity * unit_price) AS total_revenue
FROM sales_data
WHERE sale_status = 'Completed'
GROUP BY region, category
ORDER BY region, total_revenue DESC;


-- 18. RANK SALESPERSONS BY REVENUE

SELECT
    salesperson,
    SUM(quantity * unit_price) AS total_revenue,
    RANK() OVER (
        ORDER BY SUM(quantity * unit_price) DESC
    ) AS revenue_rank
FROM sales_data
WHERE sale_status = 'Completed'
GROUP BY salesperson
ORDER BY revenue_rank;


-- 19. RUNNING TOTAL OF MONTHLY REVENUE

WITH monthly_sales AS (
    SELECT
        DATE_TRUNC('month', sale_date)::DATE AS sales_month,
        SUM(quantity * unit_price) AS revenue
    FROM sales_data
    WHERE sale_status = 'Completed'
    GROUP BY DATE_TRUNC('month', sale_date)
)
SELECT
    sales_month,
    revenue,
    SUM(revenue) OVER (
        ORDER BY sales_month
    ) AS running_revenue
FROM monthly_sales
ORDER BY sales_month;


-- 20. FINAL SALES KPI DASHBOARD

SELECT
    COUNT(*) AS total_sales_records,
    COUNT(*) FILTER (
        WHERE sale_status = 'Completed'
    ) AS completed_sales,
    COUNT(*) FILTER (
        WHERE sale_status = 'Cancelled'
    ) AS cancelled_sales,
    SUM(quantity * unit_price) FILTER (
        WHERE sale_status = 'Completed'
    ) AS total_revenue,
    ROUND(
        AVG(quantity * unit_price) FILTER (
            WHERE sale_status = 'Completed'
        ),
        2
    ) AS average_sale_value,
    ROUND(
        100.0 * COUNT(*) FILTER (
            WHERE sale_status = 'Cancelled'
        ) / COUNT(*),
        2
    ) AS cancellation_rate
FROM sales_data;
