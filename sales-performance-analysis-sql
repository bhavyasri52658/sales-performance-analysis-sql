-- 1. CREATE SALES TABLE

CREATE TABLE sales_data (
    sale_id INT PRIMARY KEY,
    product_name VARCHAR(50),
    category VARCHAR(50),
    region VARCHAR(50),
    salesperson VARCHAR(50),
    quantity INT,
    unit_price NUMERIC(10,2),
    sale_date DATE,
    sale_status VARCHAR(20)
);


